GEMINI_API_KEY = "your_key_here"

# Optional personal Notion sync. Keep the real token in Streamlit Secrets only.
NOTION_TOKEN = "secret_your_internal_connection_token"
NOTION_PARENT_PAGE_ID = "your_shared_parent_page_id"
PUBLIC_APP_URL = "https://japanese-ocr-analyzer-vn.streamlit.app/"

# Optional after first bootstrap. The app caches these non-secret IDs in SQLite.
NOTION_LESSONS_DATABASE_ID = ""
NOTION_LESSONS_DATA_SOURCE_ID = ""
NOTION_ITEMS_DATABASE_ID = ""
NOTION_ITEMS_DATA_SOURCE_ID = ""
